{
  "name": "academic-jarvis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/run-bash.mjs scripts/install-ci.sh",
    "dev": "node scripts/run-with-env.mjs WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "node scripts/run-bash.mjs scripts/build-verified.sh",
    "start": "node scripts/run-with-env.mjs WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-loader ./scripts/cloudflare-validation-loader.mjs --test tests/rendered-html.test.mjs && npm run test:setup && npm run test:view",
    "test:router": "node --experimental-strip-types --test tests/command-router.test.mjs",
    "test:setup": "node --test tests/windows-setup.test.mjs",
    "test:view": "node --experimental-strip-types --test tests/dashboard-view.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "node scripts/run-bash.mjs scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "node scripts/run-bash.mjs scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module",
  "displayName": "Academic Jarvis"
}
