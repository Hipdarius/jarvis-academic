# Public source locations
WEBUNTIS_BASE_URL=https://lam.webuntis.com/WebUntis/
ACADEMY_MOODLE_BASE_URL=https://academy.am.lu/
EDU_MOODLE_BASE_URL=https://ssl.education.lu/eduMoodle/
TEAMS_BASE_URL=https://teams.microsoft.com/

# Browser session and local worker state. Keep these outside version control.
# Windows setup writes equivalent paths to %LOCALAPPDATA%\AcademicJarvis\worker.env.
JARVIS_BROWSER_PROFILE_DIR=/data/browser-profile
JARVIS_STATE_DIR=/data/work
JARVIS_SCHOOL_FILES_DIR=/data/school-files
JARVIS_CAPTURE_SCREENSHOTS=false
JARVIS_MAX_DOCUMENT_MB=25
JARVIS_MAX_FILES_PER_SOURCE=40
JARVIS_MAX_MOODLE_COURSES=24
JARVIS_MAX_MOODLE_ASSIGNMENTS=80
JARVIS_MAX_TEAMS_ASSIGNMENTS=80
JARVIS_MAX_TEAMS_ASSIGNMENT_DETAILS=30

JARVIS_TIMEZONE=Europe/Luxembourg
JARVIS_SYNC_INTERVAL_MINUTES=30
JARVIS_AGENT_POLL_SECONDS=60

# IAM automatic login. The password itself belongs in a DPAPI/secret file,
# never in this environment file and never in chat.
JARVIS_ALLOW_PASSWORD_LOGIN=false
JARVIS_IAM_USERNAME=
JARVIS_IAM_PASSWORD_FILE=/run/secrets/iam_password

# Generate the worker token inside Jarvis -> Systems and store it in this file.
# On Windows, use .\scripts\jarvis.ps1 token instead of putting the token here.
JARVIS_DASHBOARD_URL=https://academic-jarvis.darius-ferent.chatgpt.site
JARVIS_WORKER_TOKEN_FILE=/run/secrets/worker_token

# Queue a bounded curator -> planner -> reviewer run after real source changes.
# Set false to disable proactive academic agents without stopping synchronization.
JARVIS_AGENT_AUTO_TRIAGE=true

# Future code improvements require both an explicit approval in Systems and
# this local worker gate. Work stays on a separate agent/* branch: generated
# code is not executed, pushed, merged, or deployed automatically.
JARVIS_AGENT_CODE_ENABLED=false

# Optional server-side router. Never expose this key to the browser or commit it.
# Without a key, Universal Command uses the deterministic local router.
OPENAI_API_KEY=
JARVIS_COMMAND_MODEL=gpt-5.6-luna

# Optional provider router. Model identifiers remain configurable because
# provider catalogs change. Worker API keys may alternatively use KEY_FILE
# variables, such as OPENAI_API_KEY_FILE or JARVIS_HERMES_API_KEY_FILE.
JARVIS_HERMES_BASE_URL=http://hermes:8642/v1
JARVIS_HERMES_API_KEY=
JARVIS_HERMES_MODEL=hermes-agent
NOUS_API_KEY=
NOUS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Comma-separated fallbacks, cheapest/most appropriate first.
JARVIS_AGENT_ROUTE_TRIAGE=nous,openrouter,openai,hermes
JARVIS_AGENT_ROUTE_PLANNING=openai,anthropic,hermes,openrouter,nous
JARVIS_AGENT_ROUTE_REVIEW=anthropic,openai,hermes,openrouter
JARVIS_AGENT_ROUTE_CODE_CHANGE=openai,anthropic,hermes,openrouter,nous
